# Minimale grub.cfg - bootet direkt, kein Menue

insmod all_video
insmod gzio
insmod part_gpt
insmod part_msdos
insmod btrfs

set timeout=0
set default=0

# Root-Dateisystem finden (btrfs, subvol=linux)
search --no-floppy --fs-uuid --set=root 35966b02-bd2c-402d-b0ed-957ed51b91cf
set btrfs_relative_path=y

menuentry 'Linux (direct boot)' {
    echo 'Loading kernel...'
    linux  /linux/vmlinuz  root=UUID=35966b02-bd2c-402d-b0ed-957ed51b91cf ro rootflags=subvol=linux
    echo 'Loading initrd...'
    initrd /linux/initrd.img
    boot
}
