# proxy settings and target root for debootstrap
export proxy=http://192.168.178.48:3142

# ln ../../config.env config.env -s
export ROOT_INSTALL=/tmp/debootstrap # TEMPFS Reommended for fast install, if you have enough RAM (4GB+), will speed up installation!
export ROOT_TARGET=/mnt/linux # if $MOUNT_REAL_ROOT then, using that as mountpoint for $FSTAB_ROOT_DEVICE, required for bootloader install!

export INSTALL_STEPS=base,pkg-foldingAtHome,desktop,user,bootloader # base,pkg-foldingAtHome,desktop,user,bootloader

export INSTALL_BOOTLOADER=grub-pc # none, grub-efi, grub-pc
export INSTALL_CHROOT_ONLY=false # true if u what to use debian on phone or other chroot app
export INSTALL_CLI_TOOLS=true # lsbk, htop, screen, ... "template/debootstrap/base/03-packages-cli-tools.txt"
export INSTALL_DESKTOP_ENVIRONMENT=mate # none, mate
export INSTALL_DESKTOP_PACKAGES=true # mate-system-monitor, firefox, vlc, audacity, ... ("/debootstrap/desktop/10-packages-gtk-apps.txt", "/debootstrap/desktop/15-packages-custom.txt")
export INSTALL_KERNEL=true # initramfs, kernel, ... (required for bootloader)
export INSTALL_NETWORK_TOOLS=true # only false if u are in chroot or small system. (installs systemd-networkd, ...)
export INSTALL_DCONF_TEMPLATE=true # apply "template/etc/dconf", false removes template (windows calls that 'regedit')

# export INSTALL_FIRMWARE=true # TODO xD
export BOOTLOADER_BIOS_DEVICE=/dev/sdf # only required for BIOS boot (grub-pc)
export BOOTLOADER_BIOS_PARTITION=none # not required btrfs, maybe required for other filesystems, like encrypted ones
export BOOTLOADER_EFI_PARTITION=none # only required for UEFI boot (GRUB x86_64-efi)
export FORMART_EFI_PARTITION=false # formatting the EFI partition (TODO)
export FSTAB_BOOT_BIOS_DEVICE_MOUNTPOINT=/boot # if efi (/boot/efi), if bios (/boot)
export FSTAB_BOOT_BIOS_DEVICE=none # UUID of the boot partition
export FSTAB_BOOT_EFI_DEVICE_MOUNTPOINT=/boot/efi # if efi (/boot/efi), if bios (/boot)
export FSTAB_BOOT_EFI_DEVICE=none # UUID of the boot partition
export FSTAB_BUILD=true # build fstab with the above settings, set false if you want to use a custom fstab
export FSTAB_ROOT_DEVICE_TYPE=btrfs # filesystem type (btrfs)
export FSTAB_ROOT_DEVICE=UUID=1b374dd8-771f-4019-8b84-8a2d753265a9 # UUID of the root partition
export FSTAB_ROOT_MOUNT_OPTIONS="noatime,nodiratime,compress=zstd:5,subvol=linux,space_cache=v2" # mount options for the root partition (ssd -> zstd:3, hdd zstd:5)
export FSTAB_SWAP_DEVICE=UUID=32e85f21-1dc5-4ad4-a5da-8123358b3dfa # UUID of the swap partition, none if no swap partition is used
export MOUNT_REAL_BOOT=true # needed for grub-install, set false if already mounted by host system
export MOUNT_REAL_ROOT=true # needed for grub-install, set false if already mounted by host system
export KERNEL_CMDLINE= # everyone loves 'quit slash' i hate it xD if u want it add it

# Folding at Home config
export FAH_DOWNLOAD_CURRENT="https://download.foldingathome.org/releases/public/fah-client/debian-10-64bit/release/fah-client_8.5.5-64bit-release.tar.bz2"
export FAH_AUTOSTART=true
export FAH_AUTOSTART_WAIT=0 # enter 20 if u using gpu
export FAH_USERNAME=LFF5644
export FAH_TEAM=258995
export FAH_LIVE_LOGIN=true

# for chroot install.sh
export NEW_HOSTNAME=LFF-ExoneMiniI5G3-2013
export NEW_ROOT_PASSWD=true # true if u want to set an root password
export NEW_USER_AUTOLOGIN=true # true if u want to autologin the user (only for desktop install)
export NEW_USER_GROUPS=tty,cdrom,floppy,sudo,audio,dip,video,plugdev,users,render # none if u dont want extra groups
export NEW_USER=lff # none, if u dont want an user (not recommend!)

export TARGET_HARDWARE_TYPE="pc" # laptop, pc
export NETWORK_DHCP=true # set systemd-networkd ether to DHCP


# DONT TOUCH BELOW THIS LINE UNLESS YOU KNOW WHAT YOU ARE DOING

# just leave me alive haha i m the log function xD
log() {
	local msg="$1"
	local caller_file="${BASH_SOURCE[1]:-$0}"
	echo -e "$msg"
	echo "[$(date +'%Y-%m-%d %H:%M:%S')][$caller_file] $msg" >> /debootstrap/install.log
}

apt_install() {
	packagesListFile="$1"
	packages=$(grep -vE '^\s*#|^\s*$' "$packagesListFile" | xargs)
	log "Installing packages: $packages"
	time apt install --no-install-recommends $packages -y
	if [ $? -ne 0 ]; then
		log "Error installing packages!"
		sleep 15
		exit 1
	fi
}
apt_install_package(){
	log "apt install $@"
	time apt install --no-install-recommends -y -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false $@
	if [ $? -ne 0 ]; then log "Failed to APT INSTALL: $@"; exit 1; fi
}
apt_update(){
	log "apt update, ignore ssl certs xD ..."
	apt -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false update
	if [ $? -ne 0 ]; then log "Failed to APT UPDATE"; exit 1; fi
}
contains_package() {
    local file="$1"
    local search="$2"
    grep -vE '^\s*#|^\s*$' "$file" | grep -qxF "$search"
}
download(){
	local source="$1"
	local target="$2"
	wget --no-check-certificate -O "$target" "$source"
	if [ $? -ne 0 ]; then log "Failed to Download ('$target' <- '$source')"; sleep 15; exit 1; fi
}

