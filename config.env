# DONT TOUCH BELOW THIS LINE UNLESS YOU KNOW WHAT YOU ARE DOING

# just leave me alive haha i m the log function xD
log() {
	local msg="$1"
	local caller_file="${BASH_SOURCE[1]:-$0}"
	echo -e "$msg"
	echo "[$(date +'%Y-%m-%d %H:%M:%S')][$caller_file] $msg" >> /debootstrap/install.log
}

apt_install() {
	packagesListFile="$1"
	packages=$(grep -vE '^\s*#|^\s*$' "$packagesListFile" | xargs)
	log "Installing packages: $packages"
	DEBIAN_FRONTEND=noninteractive apt install --no-install-recommends -y -qq $packages
	if [ $? -ne 0 ]; then
		log "Error installing packages!"
		sleep 15
		exit 1
	fi
}
apt_install_package(){
	log "apt install $@"
	DEBIAN_FRONTEND=noninteractive apt install --no-install-recommends -y -qq -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false $@
	if [ $? -ne 0 ]; then log "Failed to APT INSTALL: $@"; exit 1; fi
}
apt_update(){
	log "apt update, ignore ssl certs xD ..."
	DEBIAN_FRONTEND=noninteractive apt -o Acquire::https::Verify-Peer=false -q -o Acquire::https::Verify-Host=false update
	if [ $? -ne 0 ]; then log "Failed to APT UPDATE"; exit 1; fi
	log "apt update done."
}
contains_package() {
    local file="$1"
    local search="$2"
    grep -vE '^\s*#|^\s*$' "$file" | grep -qxF "$search"
}
download(){
	local source="$1"
	local target="$2"
	wget --no-check-certificate -O "$target" "$source"
	if [ $? -ne 0 ]; then log "Failed to Download ('$target' <- '$source')"; sleep 15; exit 1; fi
}
load_config_section(){
	local file="$1"
	local prefix=$2
	local section=$3
	log "loading '$file' to bash env '$$prefix*'..."
	local result="$(awk -F= -v p="$prefix" -v s="[$section]" '$0~/^\[/{c=$0} c==s&&/=/{print p $1 "=\"" $2 "\""}' "$file")"
	if [ "$?" -ne 0 ] || [ -z "$result" ]; then log "Error: Failed load config from config '$file' to $$prefix, corrupt or not exist! continue..."; sleep 10; return 1; fi
	eval "$result"
	echo -e "\n---- LOAD VARS FROM '$file' ----\n$result\n--- loaded. ---\n"
}
extract_with_list(){
	local archive="$1"
	local target="$2"
	local list="$3"
	log "Extracting '$archive' with list '$list' ..."
	mkdir -p "$target"
	# download -> tar -xJf -> extract with list (extrem :P)
	download "$archive" - | tar -xJf - -C "$target" -T <(tr -d '\r' < "$list" | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' | sed 's|^\.\/||; s|^|./|')
	# time tar -xf "$archive" -C "$target" -T <(tr -d '\r' < "$list" | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' | sed 's|^\.\/||; s|^|./|')
	if [ "$?" -ne 0 ]; then log "Error: Failed to extract archive '$archive' to '$target' used list '$list', continuing..."; sleep 15; fi
	ls -l "$target"
}

